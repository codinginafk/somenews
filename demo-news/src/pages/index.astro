---
import Layout from '../layouts/Layout.astro';
import Ticker from '../components/Ticker.astro';
import NewsCard from '../components/NewsCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Newsletter from '../components/Newsletter.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hero = posts.find(p => p.data.featured) ?? posts[0];
const heroRest = posts.filter(p => p.slug !== hero?.slug);
const topChecks = heroRest.slice(0, 8);
const reality = posts.filter(p => p.data.category === 'Reality Check');
const numbers = posts.filter(p => p.data.category === 'By the Numbers');
const countries = posts.filter(p => p.data.category === 'Countries');
const lab = posts.filter(p => p.data.category === 'Lab Tested');
const mostRead = [...posts].sort((a,b) => Number(b.data.trending) - Number(a.data.trending)).slice(0,5);
const realityFeed = [...new Set([...reality, ...heroRest].map(p => p.slug))].map(slug => posts.find(p => p.slug === slug)!).filter(Boolean).slice(0,6);
---

<Layout title="Rent Free News — Reality checks with receipts">
  <Ticker />

  <div class="max-w-[1280px] mx-auto px-4">
    <!-- HERO BENTO: 2/3 + 1/3 stack (hierarchical grid, NNg F-pattern: top story first) -->
    <div class="pt-5 grid lg:grid-cols-3 gap-4">
      <div class="lg:col-span-2">
        {hero && <NewsCard variant="hero" href={`/${hero.slug}/`} title={hero.data.title} excerpt={hero.data.excerpt} category={hero.data.category} author={hero.data.author} pubDate={hero.data.pubDate} verdict={hero.data.verdict} />}
      </div>
      <div class="grid gap-4">
        {heroRest.slice(0,2).map(p => (
          <NewsCard href={`/${p.slug}/`} title={p.data.title} excerpt={p.data.excerpt} category={p.data.category} author={p.data.author} pubDate={p.data.pubDate} image={p.data.heroImage} />
        ))}
      </div>
    </div>

    <div class="mt-4"><AdSlot slot="leaderboard" /></div>

    <!-- DENSE GRID: 4 per row on xl (fixes "only 2 per line") -->
    <SectionHeader kicker="Updated hourly" title="Top checks" href="/search/" />
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {topChecks.map((p,i) => (
        <NewsCard href={`/${p.slug}/`} title={p.data.title} excerpt={p.data.excerpt} category={p.data.category} author={p.data.author} pubDate={p.data.pubDate} image={p.data.heroImage} index={i} />
      ))}
    </div>

    <!-- LIST + RAIL: text-heavy = list view (Google playbook), attention top→bottom -->
    <div class="grid lg:grid-cols-[1fr_340px] gap-8 mt-4">
      <div>
        <SectionHeader kicker="Scannable" title="Reality Check — latest" href="/category/reality-check/" />
        <div class="rounded-[10px] border border-hairline dark:border-zinc-800 bg-white dark:bg-zinc-900 px-4 divide-y divide-stone-200 dark:divide-zinc-800">
          {realityFeed.map(p => (
            <NewsCard variant="compact" href={`/${p.slug}/`} title={p.data.title} category={p.data.category} author={p.data.author} pubDate={p.data.pubDate} image={p.data.heroImage} />
          ))}
        </div>

        <SectionHeader kicker="Method first" title="By the Numbers" href="/category/by-the-numbers/" />
        <div class="grid sm:grid-cols-2 gap-4">
          {numbers.slice(0,4).map(p => (
            <NewsCard href={`/${p.slug}/`} title={p.data.title} excerpt={p.data.excerpt} category={p.data.category} author={p.data.author} pubDate={p.data.pubDate} image={p.data.heroImage} />
          ))}
        </div>
      </div>

      <aside class="space-y-4 lg:sticky lg:top-[132px] self-start">
        <div class="rounded-[10px] border border-hairline dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5">
          <div class="kicker text-zinc-500">Most read</div>
          <ol class="mt-3 space-y-4">
            {mostRead.map((p,i) => (
              <li class="flex gap-3">
                <span class="font-display font-black text-[28px] leading-none text-zinc-300 dark:text-zinc-700">{i+1}</span>
                <div>
                  <a href={`/${p.slug}/`} class="font-display font-bold text-[15px] leading-snug hover:underline">{p.data.title}</a>
                  <div class="text-[12px] text-zinc-500 mt-0.5">{p.data.category} • {p.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'short'})}</div>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <AdSlot slot="sidebar-300x250" />
        <div class="rounded-[10px] bg-zinc-950 text-white dark:bg-white dark:text-black p-5">
          <div class="kicker opacity-70">Why trust us</div>
          <ul class="mt-2 text-[13px] leading-relaxed space-y-1.5">
            <li>• Primary dataset linked, not screenshots</li>
            <li>• Creators quoted with permission + linkback</li>
            <li>• Verdict + corrections on every page</li>
          </ul>
          <a href="/about/" class="text-[13px] font-bold underline mt-2 inline-block">Methodology →</a>
        </div>
      </aside>
    </div>

    <!-- DARK BAND: Countries -->
    <div class="mt-10 -mx-4 px-4 py-8 bg-zinc-950 text-white dark:bg-white dark:text-black rounded-[10px]">
      <div class="flex items-end justify-between pb-3 border-b-2 border-white/15 dark:border-black/15 mb-4">
        <div><div class="kicker opacity-60">Place, not rank</div><h2 class="font-display font-black text-[26px]">Countries — beyond the list</h2></div>
        <a href="/category/countries/" class="text-[13px] font-bold hover:underline">All briefs →</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {countries.map(p => (
          <a href={`/${p.slug}/`} class="group rounded-xl border border-white/10 dark:border-black/10 p-5 hover:bg-white/5 dark:hover:bg-black/5">
            <div class="kicker opacity-60">{p.data.tags?.[0] ?? 'Brief'}</div>
            <div class="font-display font-bold text-[18px] leading-snug mt-1 group-hover:underline">{p.data.title}</div>
            <div class="text-[13px] opacity-70 mt-1 clamp-2">{p.data.excerpt}</div>
          </a>
        ))}
      </div>
    </div>

    <!-- LAB: creator cards -->
    <SectionHeader kicker="Quoted with permission" title="Lab Tested × creators" href="/category/lab-tested/" />
    <div class="grid md:grid-cols-2 gap-4">
      {lab.map(p => (
        <a href={`/${p.slug}/`} class="group rounded-[10px] border border-hairline dark:border-zinc-800 p-5 bg-gradient-to-br from-white to-stone-100 dark:from-zinc-900 dark:to-zinc-900 transition">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-full bg-brand-500 text-white grid place-items-center font-bold">{p.data.author.slice(0,1)}</span>
            <div><div class="text-[13px] font-bold">{p.data.author}</div><div class="text-[12px] text-zinc-500">Stream-tested • VOD linked</div></div>
            <span class="ml-auto text-[11px] font-bold px-2 py-1 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-100">PERMISSION ✓</span>
          </div>
          <div class="font-display font-bold text-[19px] leading-snug mt-3 group-hover:underline">{p.data.title}</div>
          <div class="text-[13px] text-zinc-600 dark:text-zinc-400 mt-1 clamp-2">{p.data.excerpt}</div>
        </a>
      ))}
    </div>

    <div class="my-10"><Newsletter /></div>
  </div>
</Layout>
