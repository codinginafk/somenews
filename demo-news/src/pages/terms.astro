---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Terms of use — quote with credit — Rent Free News" description="Quote Rent Free News with credit and a link. No scraping the archive or re-uploading embedded creator videos.">
  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="kicker text-brand-600">Trust</div>
    <h1 class="font-display font-black text-[36px] tracking-[-0.02em] mt-1">Terms</h1>
    <div class="prose dark:prose-invert font-serif mt-4">
      <p>Our checks are journalism, not legal or professional advice. Quoted creators speak for themselves; embeds remain their property and are shown with permission and linkback.</p>
      <p>You may quote us with credit and a link. Do not scrape the full archive or re-upload creator videos embedded here - link the originals.</p>
      <p>Verdicts can be wrong. When they are, we correct visibly under our <a href="/corrections/">corrections policy</a>.</p>
    </div>
  </div>
</Layout>
