---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { authorSlug } from '../data/site';
import { verdictLine, toneTextClass, timeAgo } from '../data/verdict';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post: entry } = Astro.props;
const slug = entry.slug;
const articleUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://rentfreenews.com').toString();
// Built in JS, not in the attribute: a raw & inside an href={...} expression
// silently truncates the rest of the page at build time (green build, broken HTML).
const tweetUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(articleUrl)}`;
const { Content } = await entry.render();
const all = await getCollection('news');
// Freshness first: every continue-reading surface shows newest stories, and each
// surface excludes the others so the same story never appears twice in one view.
const sorted = [...all].sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const others = sorted.filter(p => p.slug !== slug);
const railNext = others.filter(p => p.data.category !== entry.data.category).slice(0, 6);
const railSlugs = new Set(railNext.map(p => p.slug));
const related = others.filter(p => p.data.category === entry.data.category).slice(0, 3);
const more = others.filter(p => p.data.category !== entry.data.category && !railSlugs.has(p.slug)).slice(0, 3);
const catFile: Record<string,string> = {
  'Reality Check': 'reality-check',
  'By the Numbers': 'by-the-numbers',
  'Countries': 'countries',
  'Lab Tested': 'lab-tested',
};
const heroImg = entry.data.heroImage ?? `/images/${catFile[entry.data.category] ?? 'reality-check'}.svg`;
// SERP/social title is decoupled from the on-page H1: headlines run long by
// editorial design, titles stay within display limits.
const pageTitle = entry.data.seoTitle ?? entry.data.title;
const pageDesc = entry.data.description ?? entry.data.excerpt;
// The one place a verdict renders: a single line under the dek (never above the
// H1 — the reader needs the claim first). Explainer and stray values → null.
const dekVerdict = verdictLine(entry.data.verdict);
---
<Layout title={pageTitle} description={pageDesc} imageAlt={entry.data.title} pubDate={entry.data.pubDate} updatedDate={entry.data.updatedDate} author={entry.data.author} isArticle={true} tags={entry.data.tags} section={entry.data.category}>
  <!-- Reading progress: transform only, no layout shift -->
  <div id="progress" class="fixed top-0 left-0 h-[3px] bg-brand-500 z-50 w-full origin-left scale-x-0"></div>

  <!-- Article column (max 720px) + rail (280px) + gap (32px) = 1032px container content.
       minmax(0,1fr) keeps the exact fit at every width >= 1024: below 1096px the
       article column simply yields (680-719px) instead of opening a dead gutter. -->
  <div class="max-w-[1064px] mx-auto px-4 py-6 grid lg:grid-cols-[minmax(0,1fr)_280px] gap-8">
    <article class="min-w-0 max-w-[720px] mx-auto lg:mx-0">
      <nav aria-label="Section" class="flex items-center gap-3">
        <a href={`/category/${entry.data.category.toLowerCase().replace(/ /g,'-')}/`} class="kicker text-zinc-500 hover:text-brand-600">{entry.data.category}</a>
      </nav>
      <h1 class="font-display font-black text-[32px] md:text-[46px] leading-[1.05] tracking-[-0.02em] mt-2">{entry.data.title}</h1>
      <p class="font-serif text-[20px] leading-relaxed text-zinc-600 dark:text-zinc-400 mt-3">{entry.data.excerpt}</p>
      {dekVerdict && <p class="font-serif text-[17px] leading-relaxed mt-3"><strong class="text-brand-600">Verdict:</strong> <strong class={toneTextClass(dekVerdict.tone)}>{dekVerdict.phrase}</strong></p>}

      <div class="mt-5 pb-5 border-b border-hairline dark:border-zinc-800">
        <div class="flex items-center gap-3">
          <span class="w-11 h-11 rounded-full bg-zinc-950 dark:bg-white text-white dark:text-black grid place-items-center font-bold shrink-0">{entry.data.author.slice(0,1)}</span>
          <div class="text-[13px]">
            <div>By <a href={`/author/${authorSlug(entry.data.author)}/`} class="font-bold hover:underline">{entry.data.author}</a> <span class="text-zinc-500">• {entry.data.authorRole}</span></div>
            <div class="text-zinc-500">Published <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' })}</time>{entry.data.updatedDate ? <span> • Updated <time datetime={entry.data.updatedDate.toISOString()}>{entry.data.updatedDate.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' })}</time></span> : null}</div>
          </div>
          <div class="ml-auto flex gap-2">
            <a href={tweetUrl} target="_blank" rel="noopener" class="h-9 px-3 inline-flex items-center rounded-lg border border-zinc-300 dark:border-zinc-700 text-[13px] font-semibold">Share</a>
            <button id="save-link" class="h-9 px-3 rounded-lg border border-zinc-300 dark:border-zinc-700 text-[13px] font-semibold">Save link</button>
          </div>
        </div>
        {entry.data.primarySource && (
          <p class="mt-3 text-[13px] text-zinc-600 dark:text-zinc-400">Primary source: {entry.data.primarySourceUrl ? <a href={entry.data.primarySourceUrl} target="_blank" rel="noopener" class="underline decoration-brand-500 underline-offset-2 font-semibold">{entry.data.primarySource} →</a> : <strong>{entry.data.primarySource}</strong>}</p>
        )}
      </div>

      {entry.data.claim && (
        <div class="mt-5 rounded-[10px] bg-zinc-950 text-white dark:bg-white dark:text-black p-4">
          <div class="text-[11px] font-bold uppercase tracking-[0.18em] opacity-70">Viral claim {entry.data.claimSource ? `- ${entry.data.claimSource}` : ''}</div>
          <div class="font-display font-bold text-[17px] mt-1">"{entry.data.claim}"</div>
        </div>
      )}

      <figure class="mt-5">
        <div class="rounded-[10px] overflow-hidden border border-hairline dark:border-zinc-800">
          <img src={heroImg} alt={entry.data.title} width="1200" height="750" class="w-full h-auto block aspect-[16/10] object-cover" />
        </div>
        <figcaption class="mt-2 font-mono text-[11px] uppercase tracking-[0.14em] text-zinc-500">Illustration: Rent Free desk — {entry.data.category}</figcaption>
      </figure>

      {entry.data.whyItMatters && (
        <section aria-label="Why it matters" class="my-6 rounded-[10px] border border-hairline dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5">
          <div class="kicker text-brand-600">Why it matters</div>
          <p class="mt-2 font-serif text-[16px] leading-relaxed">{entry.data.whyItMatters}</p>
        </section>
      )}

      <!-- Layer-cake + F-pattern: short paras, left keywords, bullets -->
      <div class="prose-news prose dark:prose-invert mt-5 font-serif prose-p:leading-[1.75] prose-headings:font-display prose-headings:tracking-tight">
        <Content />
      </div>

      <div class="mt-6 rounded-[10px] border border-hairline dark:border-zinc-800 p-4 text-[13px] text-zinc-600 dark:text-zinc-400">
        <strong>How we checked:</strong> archived claim → primary dataset / VOD timestamp → quoted human with permission → verdict + corrections link. <a href="/corrections/" class="underline">Report an error</a>.
      </div>

      {entry.data.sources.length > 0 && (
        <aside aria-label="Sources" class="mt-8 pt-5 border-t border-hairline dark:border-zinc-800">
          <h2 class="font-display font-extrabold text-[20px] tracking-[-0.015em]">Sources</h2>
          <ul class="mt-3 space-y-2.5">
            {entry.data.sources.map(s => (
              <li class="text-[14px]"><a href={s.url} target="_blank" rel="noopener" class="underline decoration-brand-500 underline-offset-2 font-medium">{s.title} →</a> <small class="text-zinc-500">{s.publisher}</small></li>
            ))}
          </ul>
        </aside>
      )}

      {entry.data.tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {entry.data.tags.map(t => <a href={`/search/?q=${encodeURIComponent(t)}`} class="text-[12px] font-semibold px-2.5 py-1 rounded-full border border-hairline dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:border-zinc-400">#{t}</a>)}
        </div>
      )}

      <section aria-label="Reader discussion" class="mt-8 pt-5 border-t border-hairline dark:border-zinc-800">
        <h2 class="font-display font-extrabold text-[20px] tracking-[-0.015em]">Reader discussion</h2>
        <p class="mt-2 text-[14px] text-zinc-500">Conversation for this story opens with memberships. Until then: found an error? <a href="/corrections/" class="underline">Report it</a> — we correct visibly.</p>
      </section>

      <div class="mt-6"><Newsletter /></div>
    </article>

    <!-- CONTINUE-READING RAIL: always beside the article on desktop (lg+), newest
         stories first + same-section picks. Sticky below the header, max-h so every
         item stays reachable on short viewports. -->
    <aside class="space-y-4 lg:sticky lg:top-[132px] lg:max-h-[calc(100vh-148px)] lg:overflow-y-auto self-start">
      <div class="rounded-[10px] border border-hairline dark:border-zinc-800 bg-white dark:bg-zinc-900">
        <div class="px-4 py-3 border-b border-hairline dark:border-zinc-800 flex items-center justify-between gap-2">
          <span class="kicker text-zinc-500">Up next</span>
          <span class="font-mono text-[11px] text-zinc-400 shrink-0">Newest first</span>
        </div>
        <ul class="px-4 divide-y divide-stone-200 dark:divide-zinc-800">
          {railNext.map(p => (
            <li>
              <a href={`/${p.slug}/`} class="group block py-2.5">
                <div class="font-display font-bold text-[14px] leading-[1.35] clamp-2 group-hover:underline">{p.data.title}</div>
                <div class="flex items-center gap-1.5 mt-1 min-w-0">
                  <span class="font-mono text-[11px] text-zinc-400 tabular-nums shrink-0">{timeAgo(p.data.pubDate)}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a href="/" class="block px-4 py-3 border-t border-hairline dark:border-zinc-800 text-[13px] font-bold hover:underline">Front page →</a>
      </div>

      <div class="rounded-[10px] border border-hairline dark:border-zinc-800 p-4 bg-white dark:bg-zinc-900">
        <div class="kicker text-zinc-500">Related in {entry.data.category}</div>
        <div class="mt-2 space-y-3">
          {related.map(p => (
            <a href={`/${p.slug}/`} class="block group">
              <div class="font-display font-bold text-[14px] leading-snug group-hover:underline clamp-3">{p.data.title}</div>
              <div class="flex items-center gap-1.5 mt-1 min-w-0">
                <span class="font-mono text-[11px] text-zinc-400 tabular-nums shrink-0">{timeAgo(p.data.pubDate)}</span>
              </div>
            </a>
          ))}
          {related.length===0 && <p class="text-[13px] text-zinc-500">More checks dropping soon.</p>}
        </div>
        <a href={`/category/${entry.data.category.toLowerCase().replace(/ /g,'-')}/`} class="mt-3 block pt-3 border-t border-hairline dark:border-zinc-800 text-[13px] font-bold hover:underline">All {entry.data.category} →</a>
      </div>
    </aside>
  </div>

  <div class="max-w-[1064px] mx-auto px-4 pb-12">
    <div class="flex items-end justify-between border-b-2 border-zinc-950 dark:border-white pb-3 mb-4 mt-8">
      <h2 class="font-display font-black text-[22px]">Keep reading</h2>
      <a href="/search/" class="text-[13px] font-bold hover:underline">View all →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {more.map(p => <NewsCard href={`/${p.slug}/`} title={p.data.title} excerpt={p.data.excerpt} category={p.data.category} author={p.data.author} pubDate={p.data.pubDate} image={p.data.heroImage} />)}
    </div>
  </div>

  <script is:inline>
    const bar = document.getElementById('progress');
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const p = max > 0 ? h.scrollTop / max : 0;
      if (bar) bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();
    document.getElementById('save-link')?.addEventListener('click', (e) => {
      const btn = e.currentTarget;
      try {
        navigator.clipboard.writeText(location.href).then(() => {
          if (!btn) return;
          const old = btn.textContent;
          btn.textContent = 'Copied ✓';
          setTimeout(() => { btn.textContent = old; }, 1600);
        });
      } catch(err) {}
    });
  </script>
</Layout>
