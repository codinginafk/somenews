---
interface Props { slot?: string; }
const { slot='in-article' } = Astro.props;
const tall = slot.includes('side');
---
<div class={`rounded-[10px] border border-hairline dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 grid place-items-center text-center ${tall ? 'ad-reserve-side' : 'ad-reserve-leader'} p-3`}>
  <div>
    <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-400">Advertisement</div>
    <div class="text-[12px] text-zinc-400 mt-0.5">{slot}</div>
  </div>
</div>
