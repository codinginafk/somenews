---
import { verdictChip, chipClass, timeAgo } from '../data/verdict';

interface Props {
  href: string; title: string; excerpt?: string; category?: string;
  author?: string; pubDate?: Date; image?: string;
  variant?: 'hero' | 'standard' | 'compact' | 'row' | 'wire' | 'overlay';
  verdict?: string; readTime?: number; index?: number;
}
const { href, title, excerpt, category, author, pubDate, image, variant='standard', verdict, readTime=4, index } = Astro.props;
const date = pubDate?.toLocaleDateString('en-GB', { day:'numeric', month:'short', timeZone:'UTC' });
const fresh = pubDate ? timeAgo(pubDate) : '';
const chip = verdictChip(verdict);
const catFile: Record<string,string> = {
  'Reality Check': 'reality-check',
  'By the Numbers': 'by-the-numbers',
  'Countries': 'countries',
  'Lab Tested': 'lab-tested',
};
const img = image ?? `/images/${catFile[category ?? ''] ?? 'reality-check'}.svg`;
---
{variant === 'compact' ? (
  <a href={href} class="group grid grid-cols-[96px_1fr] sm:grid-cols-[120px_1fr] gap-3 sm:gap-4 items-center py-3">
    <div class="aspect-[16/10] rounded-[8px] overflow-hidden bg-[#efe7d6]">
      <img src={img} alt={title} loading="lazy" width="240" height="150" class="w-full h-full object-cover" />
    </div>
    <div class="min-w-0">
      <h4 class="font-display font-bold text-[16px] sm:text-[17px] leading-snug tracking-[-0.01em] clamp-2 group-hover:underline decoration-1 underline-offset-2">{title}</h4>
      <div class="flex items-center gap-1.5 sm:gap-2 mt-1.5 min-w-0 flex-wrap">
        {chip && <span class={`shrink-0 text-[10px] font-bold uppercase tracking-[0.08em] px-1.5 py-0.5 rounded border ${chipClass(chip.tone)}`}>{chip.label}</span>}
        <span class="font-mono text-[11px] text-zinc-400 tabular-nums shrink-0">{fresh}</span>
        <span class="text-zinc-300 dark:text-zinc-700 shrink-0">·</span>
        <span class="font-mono text-[11px] text-zinc-400 tabular-nums shrink-0">{readTime} min</span>
      </div>
    </div>
  </a>
) : variant === 'wire' ? (
  <a href={href} class="group grid grid-cols-[80px_1fr] sm:grid-cols-[96px_1fr] gap-3 items-center py-3">
    <div class="aspect-[16/10] rounded-[8px] overflow-hidden bg-[#efe7d6]">
      <img src={img} alt={title} loading="lazy" width="192" height="120" class="w-full h-full object-cover" />
    </div>
    <div class="min-w-0">
      <h3 class="font-display font-bold text-[15px] leading-[1.35] tracking-[-0.01em] clamp-2 group-hover:underline decoration-1 underline-offset-2">{title}</h3>
      <div class="flex items-center gap-1.5 mt-1 min-w-0">
        {chip && <span class={`shrink-0 text-[10px] font-bold uppercase tracking-[0.08em] px-1.5 py-0.5 rounded border ${chipClass(chip.tone)}`}>{chip.label}</span>}
        <span class="ml-auto font-mono text-[11px] text-zinc-400 tabular-nums shrink-0">{fresh}</span>
      </div>
    </div>
  </a>
) : variant === 'hero' ? (
  <a href={href} class="group block overflow-hidden rounded-[10px] bg-white dark:bg-zinc-900 text-ink dark:text-zinc-100 border border-hairline dark:border-zinc-800 border-t-4 border-t-brand-600">
    <div class="media-stable overflow-hidden bg-[#efe7d6]">
      <img src={img} alt={title} width="880" height="550" class="w-full h-full object-cover" />
    </div>
    <div class="p-5 md:p-6">
      <div class="flex items-center gap-2">
        {category && <span class="kicker text-brand-600">{category}</span>}
        {verdict && <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-hairline dark:border-zinc-700 text-zinc-700 dark:text-zinc-300">{verdict}</span>}
      </div>
      <h2 class="font-display font-extrabold text-[26px] md:text-[32px] leading-[1.1] tracking-[-0.015em] mt-2 group-hover:underline decoration-2 underline-offset-4">{title}</h2>
      {excerpt && <p class="font-serif text-zinc-600 dark:text-zinc-400 text-[16px] leading-relaxed mt-3 clamp-3">{excerpt}</p>}
      <div class="mt-4 text-[12px] text-zinc-500">{author} • {date} • {readTime} min read</div>
    </div>
  </a>
) : variant === 'row' ? (
  <a href={href} class="group flex gap-3 sm:gap-4 rounded-[10px] border border-hairline dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3 hover:border-zinc-400 dark:hover:border-zinc-600">
    <div class="w-[34%] max-w-[260px] shrink-0 aspect-[16/10] overflow-hidden rounded-[8px] bg-[#efe7d6]">
      <img src={img} alt={title} width="640" height="400" loading="lazy" class="w-full h-full object-cover" />
    </div>
    <div class="flex-1 min-w-0 flex flex-col justify-center py-0.5">
      <div class="flex items-center gap-2">
        {category && <span class="kicker text-brand-600">{category}</span>}
        {verdict && <span class="min-w-0 truncate text-[10px] font-bold px-1.5 py-0.5 rounded border border-hairline dark:border-zinc-700 text-zinc-600 dark:text-zinc-300">{verdict}</span>}
      </div>
      <h3 class="font-display font-bold text-[17px] md:text-[19px] leading-snug tracking-[-0.01em] mt-1.5 group-hover:underline clamp-3">{title}</h3>
      {excerpt && <p class="font-serif text-[14px] leading-relaxed text-zinc-600 dark:text-zinc-400 mt-1.5 clamp-2 hidden sm:block">{excerpt}</p>}
      <div class="mt-2 text-[12px] text-zinc-500">{author} • {date}</div>
    </div>
  </a>
) : (
  <a href={href} class="group flex flex-col overflow-hidden rounded-[10px] border border-hairline dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-400 dark:hover:border-zinc-600">
    <div class="media-stable overflow-hidden bg-[#efe7d6]">
      <img src={img} alt={title} loading="lazy" width="640" height="400" class="w-full h-full object-cover" />
    </div>
    <div class="p-4 flex flex-col flex-1">
      <div class="flex items-center justify-between gap-2">
        {category && <span class="kicker text-brand-600">{category}</span>}
        {typeof index === 'number' && <span class="font-display font-extrabold text-zinc-400 dark:text-zinc-600 text-[15px] leading-none">{String(index+1).padStart(2,'0')}</span>}
      </div>
      <h3 class="font-display font-bold text-[17px] leading-snug tracking-[-0.01em] mt-1.5 group-hover:underline clamp-3">{title}</h3>
      {excerpt && <p class="font-serif text-[14px] leading-relaxed text-zinc-600 dark:text-zinc-400 mt-1.5 clamp-2">{excerpt}</p>}
      <div class="mt-auto pt-3 flex items-center gap-1.5 flex-wrap min-w-0">
        {chip && <span class={`shrink-0 text-[10px] font-bold uppercase tracking-[0.08em] px-1.5 py-0.5 rounded border ${chipClass(chip.tone)}`}>{chip.label}</span>}
        <span class="font-mono text-[11px] text-zinc-400 tabular-nums shrink-0">{fresh}</span>
        <span class="text-zinc-300 dark:text-zinc-700 shrink-0">·</span>
        <span class="font-mono text-[11px] text-zinc-400 tabular-nums shrink-0">{readTime} min</span>
      </div>
    </div>
  </a>
)}
