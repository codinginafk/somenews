---
interface Props { verdict?: string; claim?: string; }
const { verdict = 'Missing Context', claim } = Astro.props;
const color = verdict.toLowerCase().includes('false') ? 'bg-red-50 border-red-200 text-red-900 dark:bg-red-950 dark:border-red-900 dark:text-red-100'
  : verdict.toLowerCase().includes('mislead') ? 'bg-amber-50 border-amber-200 text-amber-900 dark:bg-amber-950 dark:border-amber-900 dark:text-amber-100'
  : 'bg-emerald-50 border-emerald-200 text-emerald-900 dark:bg-emerald-950 dark:border-emerald-900 dark:text-emerald-100';
---
<div class={`my-6 rounded-[10px] border p-5 not-prose ${color}`}>
  <div class="text-xs font-black uppercase tracking-[0.18em] opacity-70">Verdict: {verdict}</div>
  {claim && <div class="mt-2 font-serif font-bold">Viral claim: “{claim}”</div>}
  <div class="mt-2 text-sm leading-relaxed"><slot /></div>
</div>
